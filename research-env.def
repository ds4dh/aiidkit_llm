Bootstrap: docker
From: nvidia/cuda:12.8.1-cudnn-devel-ubuntu24.04

%files
    pyproject.toml /opt/pyproject.toml
    web_tool/requirements.txt /opt/web_tool_requirements.txt

%environment
    export LC_ALL=C
    export PYTHONUNBUFFERED=1
    export VIRTUAL_ENV=/opt/venv
    export PATH="/opt/venv/bin:$PATH"
    export PYTHONPATH="${PWD}:${PYTHONPATH}"

    export MPLCONFIGDIR=/tmp/matplotlib
    export XDG_CACHE_HOME=/tmp/.cache
    export XDG_CONFIG_HOME=/tmp/.config

%post
    chmod 1777 /tmp
    mkdir -p /tmp/matplotlib /tmp/.cache /tmp/.config /tmp/uv-cache
    export DEBIAN_FRONTEND=noninteractive

    export UV_CACHE_DIR="/tmp/uv-cache"
    export TMPDIR="/tmp"
    
    # Disable rapid TTY/progress-bar redraws over network stderr
    export UV_NO_PROGRESS=1

    apt-get update && apt-get install -y \
      python3-pip python3-venv git curl build-essential ninja-build nvtop screen

    curl -LsSf https://astral.sh/uv/install.sh | env UV_INSTALL_DIR="/usr/local/bin" sh

    uv venv /opt/venv
    . /opt/venv/bin/activate

    cd /opt
    uv pip install --no-cache --no-progress -e ".[dev]"
    uv pip install --no-cache --no-progress -r /opt/web_tool_requirements.txt
    uv pip install flash-attn --no-build-isolation --no-progress

    rm -rf /tmp/uv-cache

%test
    . /opt/venv/bin/activate
    python3 -c "import sklearn; print('sklearn', sklearn.__version__)"
    python3 -c "import cuml; print('cuml import OK')"
    python3 -c "import torch; print(f'Torch: {torch.__version__}, CUDA: {torch.version.cuda}')"
    python3 -c "import cupy; print(f'CuPy: {cupy.__version__}')"
    python3 -c "import captum; print(f'Captum: {captum.__version__}')"
    python3 -c "import flash_attn; print(f'Flash Attn: {flash_attn.__version__}')"
    python3 -c "import flask; print(f'Flask: {flask.__version__}')"
    python3 -c "import umap; print(f'UMAP: {umap.__version__}')"
    python3 -c "import hdbscan; print(f'HDBSCAN: {hdbscan.__version__}')"
    python3 -c "import lifelines; print(f'Lifelines: {lifelines.__version__}')"

%runscript
    exec /bin/bash "$@"