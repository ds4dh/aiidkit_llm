# ==============================================================================
# AIIDKIT Web Tool — Environment Configuration (.env.example)
# Copy to `web_tool/.env` and customize before running `docker compose up -d`.
# ==============================================================================

# Host interface & port binding (keep 127.0.0.1 behind Nginx/Traefik on ds4dh.unige.ch)
AIIDKIT_BIND_IP=127.0.0.1
AIIDKIT_PORT=5000

# Optional built-in HTTP Basic Auth (RFC 7617).
# - Set AIIDKIT_BASIC_AUTH_PASS to a strong password for standalone / local testing.
# - Leave AIIDKIT_BASIC_AUTH_PASS empty if Nginx/Traefik already enforces Basic Auth
#   in front of the container (avoids double login prompts).
AIIDKIT_BASIC_AUTH_USER=clinician
AIIDKIT_BASIC_AUTH_PASS=change-me-before-sharing

# Set true only if running with NVIDIA Container Toolkit + CUDA PyTorch image
AIIDKIT_USE_GPU=false

# Trust X-Forwarded-* headers from reverse proxy (Nginx / Traefik / Caddy)
AIIDKIT_TRUST_PROXY=true
